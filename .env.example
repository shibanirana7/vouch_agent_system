# ── LLM Backend ──────────────────────────────────────────────────────────────
LLM_BACKEND=gemini

# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-pro

# Ollama (fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3

# ── Database ──────────────────────────────────────────────────────────────────
# asyncpg (FastAPI)
DATABASE_URL=postgresql+asyncpg://user:password@host/vouch
# psycopg2 (vector memory layer)
VECTOR_DB_URL=postgresql://user:password@host/vouch

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
